# Main Provider API Configuration (provod.ai)
OPENAI_API_KEY=your_openai_or_provod_key
OPENAI_BASE_URL=https://api.provod.ai/v1

# Speech-to-Text Dedicated Provider Configuration (ProxyAPI)
STT_API_KEY=your_proxyapi_key
STT_BASE_URL=https://api.proxyapi.ru/openai/v1
STT_MODEL=gpt-4o-mini-transcribe

# Models Configuration
DEEP_MODEL=kimi-k3
FAST_MODEL=gemini-3.1-flash-lite

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./got_it.db

# App Settings
APP_NAME=GotIt-Core-Tutor
DEBUG=True
HOST=0.0.0.0
PORT=8000
